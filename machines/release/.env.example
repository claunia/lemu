# sign-mac.sh signs the kits' macOS binaries with this identity. Copy this
# file to .env in the same folder and fill it in; git ignores .env.
# DEV_ID: a Developer ID Application identity in the keychain
#   (security find-identity -v -p codesigning lists them)
# NOTARY_PROFILE: a notarytool keychain profile
#   (xcrun notarytool store-credentials NAME makes one)
DEV_ID := Developer ID Application: Your Name (TEAMID)
NOTARY_PROFILE := notary
